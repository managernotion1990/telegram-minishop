# --- Server ---
PORT=3000
PUBLIC_URL=http://localhost:3000
# DATA_DIR: where shop.db lives. On Railway, set to the mounted volume path (e.g. /data).
# DATA_DIR=/data

# --- Admin panel ---
ADMIN_TOKEN=change-me-to-something-long

# --- Telegram (WebApp initData validation). Leave empty for guest mode. ---
TELEGRAM_BOT_TOKEN=

# --- ABA PayWay ---
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments
PAYWAY_CURRENCY=USD
PAYWAY_LIFETIME_MIN=15
PAYWAY_QR_TEMPLATE=template3_color

# --- Payments ---
# true = simulate PayWay (no real credentials needed); a mock QR auto-approves after ~20s.
PAYWAY_MOCK=true

# --- Shop defaults ---
EXCHANGE_RATE_USD_KHR=4100
